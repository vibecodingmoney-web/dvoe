# Скопируй в .env (файл .env в git не попадает) и заполни.

# Токен от @BotFather
BOT_TOKEN=

# Строка подключения Postgres (Neon / Supabase), целиком, с sslmode=require
DATABASE_URL=

# Публичный https-адрес приложения. На Render НЕ нужен (берётся RENDER_EXTERNAL_URL).
# Локально — адрес туннеля, если хочешь открывать Mini App внутри Telegram.
PUBLIC_URL=

# (необязательно) Прямая ссылка на Mini App из BotFather /newapp, например https://t.me/my_bot/app
MINIAPP_LINK=

# Ключ для внешнего вызова /cron/tick?key=... (UptimeRobot / cron-job.org)
CRON_KEY=

# Часовой пояс сервера: по нему считаются «сегодня» и время уведомлений (10:00 и т.д.)
APP_TZ=Europe/Kyiv

# Как часто можно нажимать «Думаю о тебе», в минутах (180 = 3 часа)
THOUGHT_COOLDOWN_MIN=180

# Telegram id админов через запятую (узнать свой: написать боту @userinfobot или своему боту /id).
# Админ видит переключатель «Админ-режим» и все пары. У остальных переключателя нет.
ADMIN_IDS=

# Только для локальной отладки в браузере (на проде не включать)
DEV_AUTH=0
